# URL de conexão do PostgreSQL (Railway gera isso automaticamente
# quando você adiciona o serviço PostgreSQL ao projeto).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Porta em que o servidor escuta. O Railway injeta a sua própria
# variável PORT automaticamente — em produção você não precisa
# definir esta aqui, apenas localmente.
PORT=3000

# Token secreto usado para proteger a exportação de leads em
# GET /api/leads/export. Gere um valor aleatório e forte.
ADMIN_TOKEN=troque-por-um-token-secreto-e-aleatorio
